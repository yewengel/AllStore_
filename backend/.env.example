# Server Configuration
PORT=5000
NODE_ENV=development
ETB_PER_USD=164.62

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
# On Render, set CLIENT_URL to your deployed Vercel origin. Use CLIENT_URLS for multiple origins.

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/yemelstore?retryWrites=true&w=majority

# JWT Authentication Secret (for future authentication modules)
JWT_SECRET=your_jwt_secret_key_here

# Chapa hosted checkout. Use keys from the matching test/live mode in the Chapa dashboard.
# Keep both secrets server-side and never add them to frontend/.env.
CHAPA_MODE=test
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Public HTTPS backend URL reachable by Chapa (for example, your deployed API or a secure test tunnel).
API_PUBLIC_URL=
# Optional account-configured method labels for checkout display, comma-separated.
# The hosted Chapa checkout remains the source of truth for methods available to customers.
CHAPA_AVAILABLE_METHODS=

# Manual bank transfer (leave blank to keep this option unavailable).
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_BRANCH=